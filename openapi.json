{
  "info": {
    "title": "BSIUI Messenger API",
    "description": "Development documentation",
    "version": "0.1.0"
  },
  "openapi": "3.1.2",
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "login",
                  "password",
                  "ik_pub",
                  "spk_pub",
                  "sig",
                  "opk_pub"
                ],
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "ik_pub": {
                    "description": "Base64 of a P-256 public key in SPKI (DER) form",
                    "type": "string"
                  },
                  "spk_pub": {
                    "description": "Base64 of a P-256 public key in SPKI (DER) form",
                    "type": "string"
                  },
                  "sig": {
                    "description": "Base64 ECDSA P-256/SHA-256 signature (r||s, 64 bytes) over the SPKI bytes of spk_pub, made with IK_priv",
                    "type": "string"
                  },
                  "opk_pub": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "login",
                  "password",
                  "ik_pub",
                  "spk_pub",
                  "sig",
                  "opk_pub"
                ],
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "ik_pub": {
                    "description": "Base64 of a P-256 public key in SPKI (DER) form",
                    "type": "string"
                  },
                  "spk_pub": {
                    "description": "Base64 of a P-256 public key in SPKI (DER) form",
                    "type": "string"
                  },
                  "sig": {
                    "description": "Base64 ECDSA P-256/SHA-256 signature (r||s, 64 bytes) over the SPKI bytes of spk_pub, made with IK_priv",
                    "type": "string"
                  },
                  "opk_pub": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "login",
                  "password",
                  "ik_pub",
                  "spk_pub",
                  "sig",
                  "opk_pub"
                ],
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "ik_pub": {
                    "description": "Base64 of a P-256 public key in SPKI (DER) form",
                    "type": "string"
                  },
                  "spk_pub": {
                    "description": "Base64 of a P-256 public key in SPKI (DER) form",
                    "type": "string"
                  },
                  "sig": {
                    "description": "Base64 ECDSA P-256/SHA-256 signature (r||s, 64 bytes) over the SPKI bytes of spk_pub, made with IK_priv",
                    "type": "string"
                  },
                  "opk_pub": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response for status 201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "username"
                  ],
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "username": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "postAuthRegister"
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token_type"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "const": "bearer",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "postAuthLogin"
      }
    },
    "/messages": {
      "post": {
        "tags": [
          "messages"
        ],
        "parameters": [
          {
            "name": "x-ek-pub",
            "in": "header",
            "required": true,
            "schema": {
              "description": "Sender's ephemeral public key EK_A-pub",
              "type": "string"
            }
          },
          {
            "name": "x-opk-pub",
            "in": "header",
            "required": false,
            "schema": {
              "description": "Receiver's one-time prekey used for DH4; omit when the bundle had none",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "receiver_name",
                  "msg",
                  "iv"
                ],
                "properties": {
                  "receiver_name": {
                    "type": "string"
                  },
                  "msg": {
                    "description": "Base64 of AES-GCM(MESSAGEKEY, plaintext), including the 16-byte tag",
                    "type": "string"
                  },
                  "iv": {
                    "description": "Base64 of the random 12-byte AES-GCM IV",
                    "type": "string"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "receiver_name",
                  "msg",
                  "iv"
                ],
                "properties": {
                  "receiver_name": {
                    "type": "string"
                  },
                  "msg": {
                    "description": "Base64 of AES-GCM(MESSAGEKEY, plaintext), including the 16-byte tag",
                    "type": "string"
                  },
                  "iv": {
                    "description": "Base64 of the random 12-byte AES-GCM IV",
                    "type": "string"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "receiver_name",
                  "msg",
                  "iv"
                ],
                "properties": {
                  "receiver_name": {
                    "type": "string"
                  },
                  "msg": {
                    "description": "Base64 of AES-GCM(MESSAGEKEY, plaintext), including the 16-byte tag",
                    "type": "string"
                  },
                  "iv": {
                    "description": "Base64 of the random 12-byte AES-GCM IV",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response for status 201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "created_at"
                  ],
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "created_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "postMessages"
      }
    },
    "/messages/update/{since_id}": {
      "get": {
        "tags": [
          "messages"
        ],
        "parameters": [
          {
            "name": "since_id",
            "in": "path",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "format": "integer",
                  "default": 0,
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "senders"
                  ],
                  "properties": {
                    "senders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "username",
                          "count",
                          "last_id"
                        ],
                        "properties": {
                          "username": {
                            "type": "string"
                          },
                          "count": {
                            "type": "number"
                          },
                          "last_id": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getMessagesUpdateBySince_id"
      }
    },
    "/messages/history/{since_id}/{receiver_name}": {
      "get": {
        "tags": [
          "messages"
        ],
        "parameters": [
          {
            "name": "since_id",
            "in": "path",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "format": "integer",
                  "default": 0,
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          {
            "name": "receiver_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "sender_name",
                      "receiver_name",
                      "msg",
                      "iv",
                      "ek_pub",
                      "opk_pub",
                      "created_at"
                    ],
                    "properties": {
                      "id": {
                        "type": "number"
                      },
                      "sender_name": {
                        "type": "string"
                      },
                      "receiver_name": {
                        "type": "string"
                      },
                      "msg": {
                        "description": "Base64 AES-GCM ciphertext (with tag)",
                        "type": "string"
                      },
                      "iv": {
                        "nullable": true,
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ek_pub": {
                        "nullable": true,
                        "description": "Base64 of a P-256 public key in SPKI (DER) form",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "opk_pub": {
                        "nullable": true,
                        "description": "Base64 of a P-256 public key in SPKI (DER) form",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "created_at": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getMessagesHistoryBySince_idByReceiver_name"
      }
    },
    "/{username}/keys": {
      "get": {
        "tags": [
          "keys"
        ],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "username",
                    "ik_pub",
                    "spk_pub",
                    "sig",
                    "opk_pub"
                  ],
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "ik_pub": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    },
                    "spk_pub": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    },
                    "sig": {
                      "type": "string"
                    },
                    "opk_pub": {
                      "nullable": true,
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getByUsernameKeys"
      }
    },
    "/keys/opk": {
      "get": {
        "tags": [
          "keys"
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count"
                  ],
                  "properties": {
                    "count": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getKeysOpk"
      },
      "post": {
        "tags": [
          "keys"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "opk_pub"
                ],
                "properties": {
                  "opk_pub": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "opk_pub"
                ],
                "properties": {
                  "opk_pub": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "opk_pub"
                ],
                "properties": {
                  "opk_pub": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "description": "Base64 of a P-256 public key in SPKI (DER) form",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count"
                  ],
                  "properties": {
                    "count": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "postKeysOpk"
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
